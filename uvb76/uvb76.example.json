{
  "listen": {
    "addr": ":8443",
    "tls_cert_file": "/etc/uvb76/cert.pem",
    "tls_key_file": "/etc/uvb76/key.pem"
  },
  "auth": {
    "username": "admin",
    "password_sha256": "[REDACTED]"
  },
  "scrape": {
    "interval_seconds": 30,
    "timeout_milliseconds": 5000
  },
  "latency": {
    "http": {
      "enabled": true,
      "interval_seconds": 15,
      "timeout_milliseconds": 10000,
      "window_seconds": 300,
      "retained_range_seconds": 3000,
      "histogram_buckets_ms": [5, 10, 25, 50, 100, 250, 500, 1000, 2500, 5000],
      "recent_samples_max": 100
    },
    "icmp": {
      "enabled": true,
      "interval_seconds": 1,
      "timeout_seconds": 3,
      "window_seconds": 300,
      "retained_range_seconds": 3000,
      "histogram_buckets_ms": [1, 5, 10, 25, 50, 100, 250, 500, 1000],
      "recent_samples_max": 300
    }
  },
  "diagnostics": {
    "enabled": true,
    "capture_on_spike": true,
    "timeout_ms": 1500,
    "cooldown_seconds": 90,
    "peers": [
      {
        "name": "tovarisch-home",
        "base_url": "http://10.77.0.1:8080",
        "targets": ["kamatera"]
      }
    ]
  },
  "targets": [
    {
      "id": "home-router",
      "name": "Home Router Tovarisch",
      "base_url": "https://192.168.1.1:9080",
      "enabled": true
    },
    {
      "id": "vps-node",
      "name": "VPS Tovarisch",
      "base_url": "https://vps.example.com:9080",
      "enabled": true
    },
    {
      "id": "kamatera",
      "name": "Kamatera (London)",
      "base_url": "http://10.149.149.1:8317",
      "enabled": true
    },
    {
      "id": "office-gateway",
      "name": "Office Gateway",
      "base_url": "https://10.0.0.1:9080",
      "enabled": false
    }
  ]
}
