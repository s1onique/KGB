{
  "$schema": "https://kgb.example.com/secret-rules-v1.schema.json",
  "version": "1.0.0",
  "description": "Canonical secret rule registry for UVB-76 artifact secret hygiene. One rule ID has exactly one meaning across Python, Go, tests, and documentation.",
  "scope_values": ["universal", "artifact_context"],
  "severity_values": ["critical", "high", "medium"],
  "allowlistable_values": [true, false],
  "detector_kind_values": ["pattern", "field_name", "header_name", "url_component", "structured_json"],
  "rules": [
    {
      "rule_id": "UVB76-SECRET-0001",
      "class": "private_key_pem",
      "scope": "universal",
      "severity": "critical",
      "allowlistable": false,
      "safe_explanation": "generic private key PEM block detected",
      "safe_remediation": "Remove or replace with [REDACTED]",
      "detector_kind": "pattern",
      "pattern": "-----BEGIN PRIVATE KEY-----"
    },
    {
      "rule_id": "UVB76-SECRET-0002",
      "class": "encrypted_private_key_pem",
      "scope": "universal",
      "severity": "critical",
      "allowlistable": false,
      "safe_explanation": "encrypted private key PEM block detected",
      "safe_remediation": "Remove or replace with [REDACTED]",
      "detector_kind": "pattern",
      "pattern": "-----BEGIN ENCRYPTED PRIVATE KEY-----"
    },
    {
      "rule_id": "UVB76-SECRET-0003",
      "class": "rsa_private_key_pem",
      "scope": "universal",
      "severity": "critical",
      "allowlistable": false,
      "safe_explanation": "RSA private key PEM block detected",
      "safe_remediation": "Remove or replace with [REDACTED]",
      "detector_kind": "pattern",
      "pattern": "-----BEGIN RSA PRIVATE KEY-----"
    },
    {
      "rule_id": "UVB76-SECRET-0004",
      "class": "ec_private_key_pem",
      "scope": "universal",
      "severity": "critical",
      "allowlistable": false,
      "safe_explanation": "EC private key PEM block detected",
      "safe_remediation": "Remove or replace with [REDACTED]",
      "detector_kind": "pattern",
      "pattern": "-----BEGIN EC PRIVATE KEY-----"
    },
    {
      "rule_id": "UVB76-SECRET-0005",
      "class": "openssh_private_key_pem",
      "scope": "universal",
      "severity": "critical",
      "allowlistable": false,
      "safe_explanation": "OpenSSH private key PEM block detected",
      "safe_remediation": "Remove or replace with [REDACTED]",
      "detector_kind": "pattern",
      "pattern": "-----BEGIN OPENSSH PRIVATE KEY-----"
    },
    {
      "rule_id": "UVB76-SECRET-0010",
      "class": "authorization_bearer",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "non-redacted Authorization Bearer header value",
      "safe_remediation": "Replace credential value with [REDACTED]",
      "detector_kind": "header_name",
      "header_pattern": "^Authorization:\\s*Bearer\\s+"
    },
    {
      "rule_id": "UVB76-SECRET-0011",
      "class": "authorization_basic",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "non-redacted Authorization Basic header value",
      "safe_remediation": "Replace credential value with [REDACTED]",
      "detector_kind": "header_name",
      "header_pattern": "^Authorization:\\s*Basic\\s+"
    },
    {
      "rule_id": "UVB76-SECRET-0012",
      "class": "proxy_authorization",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "non-redacted Proxy-Authorization header value",
      "safe_remediation": "Replace credential value with [REDACTED]",
      "detector_kind": "header_name",
      "header_pattern": "^Proxy-Authorization:"
    },
    {
      "rule_id": "UVB76-SECRET-0013",
      "class": "api_key_header",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "non-redacted X-API-Key header value",
      "safe_remediation": "Replace with [REDACTED]",
      "detector_kind": "header_name",
      "header_pattern": "^X-API-Key:"
    },
    {
      "rule_id": "UVB76-SECRET-0020",
      "class": "session_token_header",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "non-redacted X-Session-Token header value",
      "safe_remediation": "Replace token value with [REDACTED]",
      "detector_kind": "header_name",
      "header_pattern": "^X-Session-Token:"
    },
    {
      "rule_id": "UVB76-SECRET-0030",
      "class": "cookie_credential",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "non-redacted Cookie header with credential value",
      "safe_remediation": "Replace cookie value with [REDACTED]",
      "detector_kind": "header_name",
      "header_pattern": "^Cookie:"
    },
    {
      "rule_id": "UVB76-SECRET-0031",
      "class": "set_cookie_credential",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "non-redacted Set-Cookie header with credential value",
      "safe_remediation": "Replace cookie value with [REDACTED]",
      "detector_kind": "header_name",
      "header_pattern": "^Set-Cookie:"
    },
    {
      "rule_id": "UVB76-SECRET-0032",
      "class": "uvb76_session_cookie",
      "scope": "artifact_context",
      "severity": "critical",
      "allowlistable": false,
      "safe_explanation": "non-redacted uvb76_session cookie value",
      "safe_remediation": "Replace cookie value with [REDACTED]",
      "detector_kind": "pattern",
      "pattern": "uvb76_session=[A-Za-z0-9+/=_-]+"
    },
    {
      "rule_id": "UVB76-SECRET-0040",
      "class": "password_field",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "non-redacted password field value",
      "safe_remediation": "Replace with [REDACTED]",
      "detector_kind": "field_name",
      "field_names": ["password", "admin_password", "passwd"]
    },
    {
      "rule_id": "UVB76-SECRET-0041",
      "class": "password_hash_field",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "non-redacted password hash field value",
      "safe_remediation": "Replace with [REDACTED]",
      "detector_kind": "field_name",
      "field_names": ["password_hash", "admin_password_hash", "password_sha256", "password-hash"]
    },
    {
      "rule_id": "UVB76-SECRET-0050",
      "class": "generic_token_field",
      "scope": "artifact_context",
      "severity": "medium",
      "allowlistable": false,
      "safe_explanation": "non-redacted generic token field value",
      "safe_remediation": "Replace with [REDACTED]",
      "detector_kind": "field_name",
      "field_names": ["api_key", "api_token", "access_token", "refresh_token", "session_token", "session_id", "csrf_token", "bearer_token", "secret", "client_secret", "session_key"]
    },
    {
      "rule_id": "UVB76-SECRET-0060",
      "class": "client_key_data",
      "scope": "artifact_context",
      "severity": "critical",
      "allowlistable": false,
      "safe_explanation": "non-redacted client key data field value",
      "safe_remediation": "Replace with [REDACTED]",
      "detector_kind": "field_name",
      "field_names": ["client_key_data"]
    },
    {
      "rule_id": "UVB76-SECRET-0061",
      "class": "private_key_data",
      "scope": "artifact_context",
      "severity": "critical",
      "allowlistable": false,
      "safe_explanation": "non-redacted private key data field value",
      "safe_remediation": "Replace with [REDACTED]",
      "detector_kind": "field_name",
      "field_names": ["private_key", "private_key_data"]
    },
    {
      "rule_id": "UVB76-SECRET-0070",
      "class": "credential_bearing_http_url",
      "scope": "artifact_context",
      "severity": "critical",
      "allowlistable": false,
      "safe_explanation": "URL with embedded userinfo credentials detected",
      "safe_remediation": "Remove userinfo or sanitize URL",
      "detector_kind": "url_component",
      "pattern": "://[^:]+:[^@]+@"
    },
    {
      "rule_id": "UVB76-SECRET-0071",
      "class": "credential_bearing_database_dsn",
      "scope": "artifact_context",
      "severity": "critical",
      "allowlistable": false,
      "safe_explanation": "database DSN with embedded credentials detected",
      "safe_remediation": "Remove credentials from DSN",
      "detector_kind": "url_component",
      "pattern": "(?:postgres|mysql|mongodb)://[^:]+:[^@]+@"
    },
    {
      "rule_id": "UVB76-SECRET-0072",
      "class": "sensitive_url_query_parameter",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "URL with sensitive query parameter containing credential",
      "safe_remediation": "Remove sensitive query parameters",
      "detector_kind": "url_component",
      "query_params": ["token", "access_token", "api_key", "password", "secret", "key", "auth", "credential"]
    },
    {
      "rule_id": "UVB76-SECRET-0080",
      "class": "jwt_like_token",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "JWT-like token detected (base64url dot-separated structure)",
      "safe_remediation": "Replace with [REDACTED]",
      "detector_kind": "pattern",
      "pattern": "eyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+"
    },
    {
      "rule_id": "UVB76-SECRET-0081",
      "class": "bearer_token_literal",
      "scope": "artifact_context",
      "severity": "high",
      "allowlistable": false,
      "safe_explanation": "Bearer token literal detected in structured context",
      "safe_remediation": "Replace with [REDACTED]",
      "detector_kind": "pattern",
      "pattern": "(?:Bearer|Token)\\s+[A-Za-z0-9_-]{32,}"
    }
  ]
}
