# Dockerfile.canary — Memory Canary Container
#
# Final image is distroless static; sha256sum is provided via a
# standalone busybox static binary copied into /usr/local/bin so
# the controller can exec it for the runtime canary-binary
# verification path.

FROM --platform=linux/amd64 gcr.io/distroless/static:nonroot

# Built outside docker by the Makefile target. The Makefile
# computes the binary SHA-256 and sets the kgb.dev/canary-binary-sha256
# label so the in-container binary can be compared against the
# committed source tree.
COPY canary /app/canary

USER nonroot

ENTRYPOINT ["/app/canary"]
