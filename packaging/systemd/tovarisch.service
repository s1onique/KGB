[Unit]
Description=KGB tovarisch leaf service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/tovarisch serve --config /etc/kgb/tovarisch.conf
Restart=on-failure
RestartSec=5s

User=tovarisch
Group=tovarisch

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tovarisch /var/cache/tovarisch /var/log/tovarisch /run/tovarisch

RuntimeDirectory=tovarisch
StateDirectory=tovarisch
CacheDirectory=tovarisch
LogsDirectory=tovarisch

CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
