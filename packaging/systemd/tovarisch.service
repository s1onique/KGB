[Unit]
Description=KGB tovarisch leaf service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/tovarisch serve
Restart=on-failure
RestartSec=5s

# ACT 1 intentionally runs without User=/Group= because the package
# does not create the dedicated system user yet. ACT 2 must add:
# User=tovarisch
# Group=tovarisch

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tovarisch /var/cache/tovarisch /var/log/tovarisch /run/tovarisch

RuntimeDirectory=tovarisch
StateDirectory=tovarisch
CacheDirectory=tovarisch
LogsDirectory=tovarisch

CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
